#!/bin/sh
# Refuse to push code that does not build or vet, in the library or in the
# conformance module. Enable once per clone:
#   git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
export GOWORK=off
go build ./... && go vet ./... && go test ./... >/dev/null
cd conformance
go build ./... && go vet ./... && go test ./... >/dev/null
